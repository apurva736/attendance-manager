{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Server - Debug",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server/src/server.js",
      "restart": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceFolder}/server",
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "name": "Server - Attach",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Chrome - Debug Client",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/client",
      "sourceMaps": true,
      "runtimeArgs": ["--disable-background-networking"]
    }
  ],
  "compounds": [
    {
      "name": "Full Stack - Server + Browser",
      "configurations": ["Server - Debug", "Chrome - Debug Client"],
      "stopAll": true
    }
  ]
}
